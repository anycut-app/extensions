{
  "name": "thumbnail-maker",
  "publisher": "anycut",
  "displayName": "Thumbnail Maker",
  "description": "Make a YouTube thumbnail from a frame of your timeline (or any image): big title, outline, badge, darken and colour. Saves a 1280×720 PNG into the project, or your Downloads folder.",
  "version": "0.3.0",
  "license": "MIT",
  "repository": "https://github.com/anycut-app/extensions",
  "bugs": "https://github.com/anycut-app/extensions/issues",
  "engines": { "anycut": "^0.2.0" },
  "icon": "media/icon.svg",
  "cover": "media/cover.png",
  "galleryBanner": { "color": "#22252e", "theme": "dark" },
  "gallery": [
    { "path": "media/thumbnail.gif", "caption": "Scrub the timeline for a frame, then type a title" },
    { "path": "media/screenshot-tab.png", "caption": "The canvas, its controls on the right, and your timeline below" },
    { "path": "media/example.png", "caption": "The 1280×720 PNG it saves into your project" }
  ],
  "categories": ["Graphics"],
  "keywords": ["thumbnail", "youtube", "image"],
  "permissions": ["timeline.read", "workspace.write", "media.import", "downloads"],
  "contributes": {
    "editors": [
      {
        "id": "thumbnail",
        "title": "Thumbnail",
        "icon": "media/icon.svg",
        "webview": "ui/index.html",
        "timeline": "optional",
        "multiple": true,
        "properties": { "webview": "ui/properties.html", "title": "Thumbnail" },
        "panels": ["core:timeline"]
      }
    ]
  }
}
