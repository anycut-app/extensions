{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anycut.app/schema/catalog.v1.schema.json",
  "title": "AnyCut extension catalog",
  "type": "object",
  "required": ["version", "extensions", "blocklist"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repo", "version", "kind", "download", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}\\.[a-z0-9][a-z0-9-]{0,39}$", "description": "publisher.name, as in the extension's package.json" },
          "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$", "description": "owner/repo on GitHub" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][\\w.-]+)?$", "description": "the exact version reviewed (semver)" },
          "kind": { "enum": ["tool", "pack"], "description": "tool = UI and/or code; pack = content only (effects, fonts, looks, caption styles, skills)" },
          "download": { "type": "string", "minLength": 1, "description": "the zip: your GitHub release asset in a pull request; the mirror in this repo's releases once published" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "runsCode": { "type": "boolean", "description": "set by publishing, from the zip" },
          "permissions": { "type": "array", "items": { "type": "string" }, "description": "set by publishing, from the zip" },
          "assets": { "type": "string", "description": "set by publishing: where its package.json, README, CHANGELOG, icon and gallery are published" },
          "published": { "type": "string", "description": "set by publishing: when this version was published" },
          "size": { "type": "integer", "minimum": 0, "description": "set by publishing: bytes of the zip" },
          "versions": {
            "type": "array",
            "description": "set by publishing: earlier versions, newest first",
            "items": { "type": "object", "required": ["version"], "properties": { "version": { "type": "string" }, "published": { "type": "string" } }, "additionalProperties": false }
          }
        },
        "additionalProperties": false
      }
    },
    "blocklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "versions": { "type": "string", "description": "a version range (\">=1.0.0 <1.2.0\", \"1.0.3\"); every version when absent" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
